<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NABD_Open_Since__c</fullName>
    <description>When the current unresolved period began: creation, or the last reopening if later.</description>
    <externalId>false</externalId>
    <formula>IF(OR(ISBLANK(Last_Reopened_At__c), Last_Reopened_At__c &lt; CreatedDate), CreatedDate, Last_Reopened_At__c)</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Open Since</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>DateTime</type>
</CustomField>
