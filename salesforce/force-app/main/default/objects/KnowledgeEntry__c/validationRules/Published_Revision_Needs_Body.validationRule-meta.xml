<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Published_Revision_Needs_Body</fullName>
    <active>true</active>
    <description>Customers may only receive published revisions with content.</description>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, &quot;Published&quot;), ISBLANK(Body__c))</errorConditionFormula>
    <errorDisplayField>Body__c</errorDisplayField>
    <errorMessage>A published revision needs body text.</errorMessage>
</ValidationRule>
