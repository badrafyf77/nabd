# For local Python commands. Docker Compose uses the internal db hostname.
# Copy to .env.nabd; Settings loads it from backend/ regardless of your cwd.
NABD_DATABASE_URL=postgresql://nabd:nabd_dev@127.0.0.1:55432/nabd
NABD_DATABASE_POOL_MIN_SIZE=1
NABD_DATABASE_POOL_MAX_SIZE=5
NABD_DATABASE_TIMEOUT_SECONDS=3

# Opt in to real database tests against the separate disposable test service:
# NABD_TEST_DATABASE_URL=postgresql://nabd:nabd_test@127.0.0.1:55433/nabd_test

# Salesforce integration user (Phase 1). Only `python -m nabd salesforce smoke`
# and later Salesforce-backed features read these. Copy the Consumer Key and
# Consumer Secret of the NABD_Backend External Client App from Salesforce Setup;
# never commit them or paste them into notes or chat.
NABD_SALESFORCE_DOMAIN_URL=https://your-domain.my.salesforce.com
NABD_SALESFORCE_CLIENT_ID=
NABD_SALESFORCE_CLIENT_SECRET=
NABD_SALESFORCE_API_VERSION=68.0
NABD_SALESFORCE_TIMEOUT_SECONDS=15
